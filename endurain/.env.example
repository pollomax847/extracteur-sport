# Copier en .env et remplir. Ce fichier est lu par docker compose (Endurain, PostgreSQL et relais).
LOCAL_PATH=/chemin/vers/le/projet/endurain/data
DB_PASSWORD=à-choisir
POSTGRES_PASSWORD=le-même-que-DB_PASSWORD
SECRET_KEY=openssl rand -hex 32
FERNET_KEY=voir https://docs.endurain.com
TZ=Europe/Paris
ENDURAIN_HOST=http://localhost:8080
BEHIND_PROXY=false
POSTGRES_DB=endurain
POSTGRES_USER=endurain
PGDATA=/var/lib/postgresql/data/pgdata

# Chemins de l'ordinateur, repris tels quels dans le conteneur relais
SPORT_PROJET=/chemin/vers/le/projet
SPORT_HOME=/home/utilisateur
SPORT_MEDIA=/media/utilisateur
